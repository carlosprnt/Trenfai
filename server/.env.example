# Puerto HTTP del backend
PORT=4000

# CORS: orígenes permitidos, separados por coma. Usa * en desarrollo.
CORS_ORIGIN=*

# Endpoint no documentado de Renfe para la flota de larga distancia.
# Este es el que alimenta el visor en tiempo-real.largorecorrido.renfe.com.
# Si Renfe cambia la URL, ajústala aquí sin tocar código.
RENFE_FLOTA_URL=https://tiempo-real.largorecorrido.renfe.com/data/flotaLD.json

# TTL del cache en milisegundos. El endpoint origen se actualiza cada ~15s,
# así que 10s es un buen compromiso entre frescura y no martillear la API.
CACHE_TTL_MS=10000

# User-Agent que usaremos al llamar a Renfe. Algunos CDNs bloquean UA vacío.
UPSTREAM_USER_AGENT=Trenfai/0.1 (+https://github.com/carlosprnt/trenfai)
